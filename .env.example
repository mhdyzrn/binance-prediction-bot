# ==========================================================
# KONFIGURASI BOT PREDIKSI BINANCE (REAL TRADING & SIMULASI)
# ==========================================================

# Ubah ke False untuk TRADING REAL menggunakan saldo asli Binance
# Ubah ke True jika ingin kembali ke Mode Simulasi latihan
SIMULATION_MODE=False

# Masukkan API Key dan Secret Key Binance Anda di bawah ini
# Pastikan di Binance (API Management) izin [Prediction Trading] atau [Spot/Margin] aktif
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Nominal taruhan per ronde (USDT)
BET_AMOUNT=1.0

# Minimal selisih harga BTC spot terhadap strike (Default: $15)
SNIPER_MIN_DIFF=15.0

# Endpoint Binance Resmi
BINANCE_BASE_URL=https://api.binance.com

# Proxy Statis (Opsional: Jika IP HP berubah-ubah, gunakan proxy statis untuk IP Whitelist Binance)
# Contoh: http://username:password@185.199.229.10:8080
BINANCE_PROXY=

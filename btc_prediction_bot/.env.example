# ========================================================
# BINANCE BTCUSDT 5-MINUTE PREDICTION BOT CONFIGURATION
# ========================================================

# 1. Mode Operasi: SIGNAL_ONLY (Default), TESTNET, atau LIVE
TRADING_MODE=SIGNAL_ONLY

# Konfirmasi Keamanan untuk Mode LIVE (Wajib diatur ke true jika ingin live)
ENABLE_LIVE_TRADING=false

# 2. Kredensial Binance API (Hanya diperlukan jika mode TESTNET atau LIVE)
# Jangan pernah membagikan Secret Key Anda kepada siapapun!
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Gunakan Binance Futures Testnet (true/false)
BINANCE_TESTNET=true

# 3. Parameter Pasar
SYMBOL=BTCUSDT

# 4. Parameter Strategi Kuantitatif
EMA_FAST_PERIOD=20
EMA_SLOW_PERIOD=50
EMA_SIDEWAYS_THRESHOLD=8.0
RSI_PERIOD=14
RSI_BUY_MIN=50.0
RSI_BUY_MAX=75.0
RSI_SELL_MIN=25.0
RSI_SELL_MAX=50.0

SWING_LOOKBACK=20
ENABLE_VOLUME_FILTER=true
VOLUME_LOOKBACK=20

ATR_PERIOD=14
MIN_ATR_THRESHOLD=15.0
MAX_CANDLE_BODY_ATR_MULT=2.5
MAX_SPREAD_USDT=5.0
COOLDOWN_MINUTES=5

# 5. Manajemen Risiko Futures
DEFAULT_LEVERAGE=3
RISK_PER_TRADE_PERCENT=1.0
TAKER_FEE_RATE=0.0005
SLIPPAGE_RATE=0.0002
STOP_LOSS_ATR_MULT=1.5
TAKE_PROFIT_ATR_MULT=2.0
